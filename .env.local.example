# Supabase — copy this file to .env.local and fill in from your project:
# https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only (never expose to the browser). Needed later for admin scripts.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# CARTO Basemaps — free key, no account needed: https://carto.com/basemaps/apikey/
# Powers the location map on space/event detail pages.
NEXT_PUBLIC_CARTO_API_KEY=YOUR_CARTO_API_KEY
