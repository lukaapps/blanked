# Supabase — copy this file to .env.local and fill in from your project:
# https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Resend — for transactional emails
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxx

# Admin notifications (where to send signup alerts)
ADMIN_EMAIL=admin@blanked.com

# App URL (for email confirmation links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
